import wollok.game.*
import personaje.*
import items.*
import menu.*


program theBindingOfRocky {
  game.boardGround("fondo.png")
  game.title("The binding of Rocky")
  game.width(16)
  game.height(16)
  game.cellSize(50)


  
  //main_menu.setPersonajes(personajes)
  game.addVisual(main_menu)
  var player = blito

  keyboard.enter().onPressDo({
    game.removeVisual(main_menu)
    game.addVisual(pistola)
    player = main_menu.obtenerPersonajeActual()
    
    game.addVisualCharacter(player)
    
    game.onCollideDo(player, { elemento =>
      elemento.colisionarCon(player)
    })
  })

  

  //keyboard.h().onPressDo({game.say(player, "hola!")})
  //keyboard.l().onPressDo({main_menu.cambiarPersonaje()})
  keyboard.right().onPressDo({
    if(game.hasVisual(main_menu)){
      main_menu.avanzarPersonaje()
    }
  })
  keyboard.left().onPressDo({
    if(game.hasVisual(main_menu)){
      main_menu.retrocederPersonaje()
    }
  })


  game.start()
}
