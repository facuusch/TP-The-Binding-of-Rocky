import src.salas.*
import wollok.game.*
import personaje.*
import items.*
import menu.*
import enemigos.*

program theBindingOfRocky {
  game.boardGround("fondo.png")
  game.title("The binding of Rocky")
  game.width(15)
  game.height(15)
  game.cellSize(50)

  game.addVisual(mainMenu)
  
  
  keyboard.enter().onPressDo({
    if(game.hasVisual(mainMenu)){
      game.removeVisual(mainMenu)
      if(!juego.fueIniciado()){
        juego.iniciarJuego()
      } else{
        juego.reiniciarJuego()
      }
      //juego.cambiarPersonaje()
      //juego.reiniciarJuego()
    }
    if(game.hasVisual(gameOver)){
      game.removeVisual(gameOver)
      game.addVisual(mainMenu)
    }
  })

  keyboard.right().onPressDo({
      if(game.hasVisual(mainMenu)){
        mainMenu.avanzarPersonaje()
      }
    })

    keyboard.left().onPressDo({
      if(game.hasVisual(mainMenu)){
        mainMenu.retrocederPersonaje()
      }
    })
  //keyboard.h().onPressDo({game.say(player, "me queda " + player.vida() + " vida")})

  game.start()
}

object juego{
  var player = null
  var iniciado = false
  const salas = [sala_1, sala_2, sala_3]
  var property salaActual = 0
  const personajesIniciados = []

  method fueIniciado() = iniciado//game.hasVisual(player)
  method cambiarPersonaje(){
    player = mainMenu.obtenerPersonajeActual()
  }

  method pasarNivel(){
    salas.get(salaActual).borrarSala()
    game.removeVisual(salas.get(salaActual))
    salaActual += 1
    if(salaActual == 3){
      game.addVisual(pantallaWin)
    } else{
      game.addVisual(salas.get(salaActual))
      salas.get(salaActual).cargarSala()
    }
    
  }

  method chequearTerminada(){
    (salas.get(salaActual)).chequearVacia()
    //aca iria tambien un chequeo si piso botones o activo una palanca o algo por el estilo
  }

  method iniciarJuego(){
    iniciado = true
    game.addVisual(sala_1)
    sala_1.cargarSala()

    player = mainMenu.obtenerPersonajeActual()
    if(not personajesIniciados.contains(player)){
      self.inicializarPersonaje(player)
      personajesIniciados.add(player)
    }
    game.addVisual(player)

    game.addVisual(spriteVida)
    spriteVida.actualizarVida(player.vida())
    //game.addVisualCharacter(player)

    keyboard.w().onPressDo({
      player.disparar(arriba)
    })
    keyboard.a().onPressDo({
      player.disparar(izquierda)
    })
    keyboard.s().onPressDo({
      player.disparar(abajo)
    })
    keyboard.d().onPressDo({
      player.disparar(derecha)
    })
    

    // game.onCollideDo(player, { elemento =>
    //     elemento.colisionarCon(player)
    // })

  }

  method inicializarPersonaje(personaje){
    //game.addVisualCharacter(personaje)

    //
    keyboard.up().onPressDo({ 
      if(personaje.position().y() < game.height()-1) personaje.mover(arriba) })
    keyboard.down().onPressDo({ 
      if(personaje.position().y() > 0) personaje.mover(abajo) })
    keyboard.right().onPressDo({ 
      if (personaje.position().x() < game.width()-1) personaje.mover(derecha) })
    keyboard.left().onPressDo({ 
      if (personaje.position().x() > 0) personaje.mover(izquierda) })
    //

    game.onCollideDo(personaje, { elemento =>
        elemento.colisionarCon(personaje)
    })

    //game.removeVisual(personaje)
  }

  method terminarJuego(){
    player.reiniciarStats()
    game.removeVisual(player)

    game.addVisual(gameOver)
  }

  method reiniciarJuego(){
    player = mainMenu.obtenerPersonajeActual()
    player.reiniciarStats()
    if(not personajesIniciados.contains(player)){
      self.inicializarPersonaje(player)
      personajesIniciados.add(player)
    }
    game.addVisual(player)
    sala_1.cargarSala()
  }
}